                  "type": "text"
                },
                {
                  "key": "attachments",
                  "type": "file",
                  "src": null
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code !== 201) pm.execution.setNextRequest(null);",
                  "pm.test(\"Attachment metadata is returned\", function () {",
                  "  const result = pm.response.json();",
                  "  pm.expect(result.complaint.attachments).to.have.lengthOf(1);",
                  "  pm.expect(result.complaint.attachments[0].mimeType).to.eql(\"image/png\");",
                  "  pm.expect(result.complaint.attachments[0].sizeBytes).to.be.above(0).and.at.most(10485760);",
                  "  pm.expect(result.complaint.attachments[0]).not.to.have.property(\"storageKey\");",
                  "  const value = result.complaint.id;",
                  "  pm.expect(value).to.be.a(\"string\").and.not.empty;",
                  "  pm.collectionVariables.set(\"attachedComplaintId\", value);",
                  "});"
                ]
              }
            }
          ]
