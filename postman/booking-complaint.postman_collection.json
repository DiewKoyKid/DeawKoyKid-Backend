{
  "info": {
    "name": "Togethr — Booking and Complaint E2E",
    "description": "Run the E2E folder in order against a running backend with migrations applied to a test database. Creates fresh accounts and records every run. Then send individual requests in Manual attachment checks after choosing local files.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "testPassword",
      "value": "PostmanTest-Only-9042"
    }
  ],
  "item": [
    {
      "name": "E2E — accounts, services, bookings and complaints",
      "item": [
        {
          "name": "Register provider",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/register/provider",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"provider_{{runId}}\",\n  \"email\": \"provider_{{runId}}@example.com\",\n  \"password\": \"{{testPassword}}\",\n  \"firstname\": \"provider\",\n  \"lastname\": \"Postman\",\n  \"consent\": true,\n  \"idCard\": \"0000000000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const vars = pm.collectionVariables;",
                  "for (const key of [\"providerToken\", \"customerToken\", \"providerId\", \"customerId\", \"hourServiceId\", \"dayServiceId\", \"secondServiceId\", \"slotId\", \"hourBookingId\", \"dayBookingId\", \"complaintId\", \"attachedComplaintId\"]) vars.unset(key);",
                  "vars.set(\"runId\", Date.now().toString(36) + Math.random().toString(36).slice(2, 8));",
                  "vars.set(\"bookingDate\", new Date(Date.now() + 7 * 86400000).toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code !== 201) pm.execution.setNextRequest(null);",
                  "pm.test(\"Save account ID\", function () {",
                  "  const result = pm.response.json();",
                  "  const value = result.user.id;",
                  "  pm.expect(value).to.be.a(\"string\").and.not.empty;",
                  "  pm.collectionVariables.set(\"providerId\", value);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login provider",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"provider_{{runId}}@example.com\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code !== 200) pm.execution.setNextRequest(null);",
                  "pm.test(\"Capture login token\", function () {",
                  "  const result = pm.response.json();",
                  "  pm.expect(result.user.id).to.eql(pm.collectionVariables.get(\"providerId\"));",
                  "  const cookie = pm.response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\").map(h => /^token=([^;]+)/.exec(h.value)).find(Boolean);",
                  "  pm.expect(cookie, \"token cookie\").to.exist;",
                  "  pm.collectionVariables.set(\"providerToken\", cookie[1]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Publish Old Town walking tour",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
