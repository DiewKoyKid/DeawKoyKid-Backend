            "url": "{{baseUrl}}/api/services",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Old Town walking tour {{runId}}\",\n  \"description\": \"Postman test service\",\n  \"location\": \"Bangkok\",\n  \"rate\": 450,\n  \"rateUnit\": \"hour\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"13:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code !== 201) pm.execution.setNextRequest(null);",
                  "pm.test(\"Service belongs to provider and has expected rate\", function () {",
                  "  const result = pm.response.json();",
                  "  pm.expect(result.service.providerId).to.eql(pm.collectionVariables.get(\"providerId\"));",
                  "  pm.expect(result.service.rate).to.eql(450);",
                  "  pm.expect(result.service.rateUnit).to.eql(\"hour\");",
                  "  const value = result.service.id;",
                  "  pm.expect(value).to.be.a(\"string\").and.not.empty;",
                  "  pm.collectionVariables.set(\"hourServiceId\", value);",
                  "});"
                ]
              }
            }
          ]
        },
