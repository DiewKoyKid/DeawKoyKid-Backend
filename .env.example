DATABASE_URL="postgresql://deawkoykid:deawkoykid@localhost:5432/deawkoykid?schema=public"

# Used to sign/verify login JWTs. Generate your own random string for real deployments —
# for local dev this placeholder is fine.
JWT_SECRET="dev-only-secret-change-me"
JWT_EXPIRES_IN="30m"

PORT=8080

# Optional absolute path to private persistent complaint storage (never public).
# Defaults to storage/complaints under the backend project.
COMPLAINT_STORAGE_DIR=

# Origin allowed to call this API with credentials (frontend dev server)
CORS_ORIGIN="http://localhost:5173"

# Outgoing email (src/services/mail.service.js). Leave SMTP_HOST empty in dev:
# emails are then logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Togethr <no-reply@togethr.local>"

# Base URL of the frontend, used for the password reset link in emails
# (falls back to CORS_ORIGIN).
FRONTEND_URL="http://localhost:5173"
