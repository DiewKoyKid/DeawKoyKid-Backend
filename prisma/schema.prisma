// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid())
  username        String    @unique @db.VarChar(50)
  email           String?   @unique @db.VarChar(254)
  password        String    @db.VarChar(255)
  firstname       String    @db.VarChar(80)
  lastname        String    @db.VarChar(80)
  gender          String?   @db.Char(1)
  bdate           DateTime? @db.Date
  bankAccount     String?   @db.VarChar(20)
  phoneNumber     String?   @db.VarChar(20)
  instagram       String?   @db.VarChar(40)
  line            String?   @db.VarChar(40)
  facebook        String?   @db.VarChar(40)
  profilePhotoUrl String?
  consentAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  provider     Provider?
  customer     Customer?
  reports      Report[]
  sentChatLogs ChatLog[] @relation("ChatLogSender")
  notifications Notification[]

  @@map("users")
}

model Provider {
  userId                String   @id
  idCard                String?  @db.VarChar(13)
  bio                   String?
  languages             String?  @db.VarChar(200)
  interests             String[] @default([])
  serviceArea           String[] @default([])
  avgRating             Decimal? @db.Decimal(3, 2)
  emergencyContactName  String?  @db.VarChar(80)
  emergencyContactPhone String?  @db.VarChar(20)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  services Service[]

  @@map("providers")
}

model Customer {
  userId String @id

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
  reviews  Review[]

  @@map("customers")
}

model Service {
  id            String  @id @default(uuid())
  providerId    String
  title         String  @db.VarChar(150)
  description   String?
  location      String  @db.VarChar(200)
  rate          Decimal @db.Decimal(10, 2)
  rateUnit      String? @db.VarChar(50)
  startTime     String? @db.VarChar(10)
  endTime       String? @db.VarChar(10)
  coverPhotoUrl String?
  isPublished   Boolean @default(true)

  provider          Provider           @relation(fields: [providerId], references: [userId])
  serviceCategories ServiceCategory[]
  bookings          Booking[]
  availabilitySlots AvailabilitySlot[]

  @@map("services")
}

model AvailabilitySlot {
  id        String   @id @default(uuid())
  serviceId String
  date      DateTime @db.Date
  startTime String   @db.VarChar(5)
  endTime   String   @db.VarChar(5)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, date, startTime, endTime])
  @@map("availability_slots")
}

model Category {
  id       String @id @default(uuid())
  category String @db.VarChar(100)

  serviceCategories ServiceCategory[]

  @@map("categories")
}

model ServiceCategory {
  serviceId  String
  categoryId String

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([serviceId, categoryId])
  @@map("service_categories")
}

enum BookingStatus {
  WAITING_FOR_CONFIRMATION
  CONFIRMED
  REJECTED
  EXPIRED
  CANCELLED
  COMPLETED
}

model Booking {
  id              String        @id @default(uuid())
  serviceId       String
  customerId      String
  bookingDate     DateTime      @db.Date
  appointmentDate DateTime      @db.Date
  startTime       String?       @db.VarChar(5)
  endTime         String?       @db.VarChar(5)
  bookingStatus   BookingStatus @default(WAITING_FOR_CONFIRMATION)
  duration        Int?
  totalPrice      Decimal?      @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  service       Service        @relation(fields: [serviceId], references: [id])
  customer      Customer       @relation(fields: [customerId], references: [userId])
  reviews       Review[]
  chatLogs      ChatLog[]
  notifications Notification[]

  @@index([serviceId, appointmentDate])
  @@index([customerId])
  @@index([bookingStatus, createdAt])
  @@map("bookings")
}

// One review per booking (US8-1). rating is 1-5, enforced by a CHECK
// constraint in the add_review_constraints migration.
model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  customerId String
  rating     Int
  comment    String?
  timestamp  DateTime @default(now())

  booking  Booking  @relation(fields: [bookingId], references: [id])
  customer Customer @relation(fields: [customerId], references: [userId])

  @@map("reviews")
}

model Report {
  id          String @id @default(uuid())
  userId      String
  topic       String @db.VarChar(150)
  description String

  user User @relation(fields: [userId], references: [id])

  @@map("reports")
}

model ChatLog {
  id        String   @id @default(uuid())
  bookingId String
  senderId  String
  content   String
  timestamp DateTime

  booking Booking @relation(fields: [bookingId], references: [id])
  sender  User    @relation("ChatLogSender", fields: [senderId], references: [id])

  @@map("chat_logs")
}

// In-app notifications (F52). `type` is NEW_BOOKING_REQUEST (F43) or one of
// BOOKING_STATUS_NOTIFICATION_TYPES in src/services/notification.service.js,
// written by the status-change hook in the same transaction as the change.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  bookingId String?
  type      String   @db.VarChar(40)
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([bookingId])
  @@map("notifications")
}
