{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend RESTful API service สำหรับระบบค้นหาและจับคู่เพื่อนเที่ยว ทำหน้าที่จัดการระบบสมาชิก, การเข้าสู่ระบบ (Authentication & Authorization), การจัดการโปรไฟล์ และการประมวลผลข้อมูลการจับคู่คู่เดินทาง",
  "main": "index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "test": "jest --runInBand",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:test": "node prisma/seed.test.js",
    "test:unit:coverage": "jest tests/unit/isUnansweredBookingExpired.test.js --verbose --coverage --collectCoverageFrom=src/utils/bookingStatus.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "docs:generate": "node scripts/generate-postman.js && node scripts/generate-openapi.js",
    "bookings:expire": "node scripts/expire-bookings.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunvat-creator/DeawKoyKid-Backend.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sunvat-creator/DeawKoyKid-Backend/issues"
  },
  "homepage": "https://github.com/sunvat-creator/DeawKoyKid-Backend#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.0",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "nodemon": "^3.1.7",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.2.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/prisma/"
    ]
  },
  "engines": {
    "node": "24.x"
  }
}
